# Radium Workflow Builder Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# Supabase Configuration
# =============================================================================
# For local development with Supabase CLI (supabase start):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-local-anon-key>
#
# For cloud Supabase:
#   Get these values from https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (only for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret (for token verification)
SUPABASE_JWT_SECRET=

# =============================================================================
# Database Configuration (Direct PostgreSQL)
# =============================================================================
# Only needed if connecting directly to PostgreSQL instead of Supabase
DATABASE_URL=

# =============================================================================
# Temporal Configuration
# =============================================================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# =============================================================================
# Kong API Gateway
# =============================================================================
KONG_ADMIN_URL=http://localhost:8001
KONG_PROXY_URL=http://localhost:8000

# =============================================================================
# Radium Rust Backend
# =============================================================================
RADIUM_COMPILER_URL=http://localhost:3020

# =============================================================================
# AI Services
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# Feature Flags
# =============================================================================
# Enable Kong API gateway integration
KONG_E2E=false

# Enable debug logging
DEBUG=false
